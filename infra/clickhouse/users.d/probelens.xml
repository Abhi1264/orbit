<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>1500000000</max_memory_usage>
            <max_execution_time>30</max_execution_time>
        </default>
        <!-- readonly=2: SELECT and per-query settings, no DDL or writes. -->
        <readonly_analytics>
            <readonly>2</readonly>
            <!-- Dashboards fan out concurrent queries; a burst must stay under the server cap. -->
            <max_memory_usage>800000000</max_memory_usage>
            <max_bytes_before_external_group_by>200000000</max_bytes_before_external_group_by>
            <max_threads>4</max_threads>
            <max_execution_time>20</max_execution_time>
            <max_result_rows>200000</max_result_rows>
            <result_overflow_mode>break</result_overflow_mode>
        </readonly_analytics>
        <!-- Metabase: smaller than readonly_analytics so it can't starve Orbit, and never truncates. -->
        <bi_analytics>
            <readonly>2</readonly>
            <max_memory_usage>600000000</max_memory_usage>
            <max_bytes_before_external_group_by>150000000</max_bytes_before_external_group_by>
            <max_threads>2</max_threads>
            <max_execution_time>60</max_execution_time>
        </bi_analytics>
    </profiles>
</clickhouse>
