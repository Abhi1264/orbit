# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# Used to sign session cookies. Change for anything beyond local use.
SECRET_KEY=change-me-in-production-32-chars-min
SESSION_TTL_HOURS=72

# --- Databases (compose overrides hosts for containers) ---
DATABASE_URL=postgresql+psycopg://probelens:probelens@localhost:5432/probelens
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=probelens
# Read-write user, used only by the seed loader.
CLICKHOUSE_USER=probelens
CLICKHOUSE_PASSWORD=probelens
# Read-only user, used by the API and worker for all analytical queries.
CLICKHOUSE_READONLY_USER=probelens_ro
CLICKHOUSE_READONLY_PASSWORD=probelens_ro
REDIS_URL=redis://localhost:6379/0

# --- AI analyst (optional) ---
# Leave LLM_API_KEY empty to run the analyst in deterministic demo mode.
# Any OpenAI-compatible endpoint works (OpenAI, Azure, Ollama, vLLM, OpenRouter...).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOOL_STEPS=10

# --- Seed ---
SEED_PROFILE=demo
SEED=42

# --- Production (make prod / OCI Ampere) ---
# APP_ENV=production requires a real SECRET_KEY (openssl rand -hex 32).
# SITE_ADDRESS=your.domain.com enables HTTPS via Caddy. Leave unset for HTTP :80
# and set APP_ENV=development so the session cookie still works without TLS.
# APP_ENV=production
# SECRET_KEY=
# SITE_ADDRESS=
# ACME_EMAIL=
# ANALYTICS_CACHE_TTL_SECONDS=900
